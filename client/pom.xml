<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fulcrologic.jxpilot</groupId>
    <artifactId>jxpilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jxpilot-client</artifactId>

  <profiles>
    <profile><id>mac-arm</id><activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><lwjgl.natives>natives-macos-arm64</lwjgl.natives><jvm.platform.args>-XstartOnFirstThread</jvm.platform.args></properties></profile>
    <profile><id>mac-x64</id><activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><lwjgl.natives>natives-macos</lwjgl.natives><jvm.platform.args>-XstartOnFirstThread</jvm.platform.args></properties></profile>
    <profile><id>linux</id><activation><os><family>unix</family><name>Linux</name></os></activation>
      <properties><lwjgl.natives>natives-linux</lwjgl.natives><jvm.platform.args>-Dnone</jvm.platform.args></properties></profile>
    <profile><id>windows</id><activation><os><family>windows</family></os></activation>
      <properties><lwjgl.natives>natives-windows</lwjgl.natives><jvm.platform.args>-Dnone</jvm.platform.args></properties></profile>
    <!-- The phase 0 latency baseline (docs/latency-measurements.md):
         MAVEN_OPTS= mvn -q -o -pl client -am test -Platency
         The root pom's latency profile skips every other test; this execution runs LatencyBaselineTest once. -->
    <profile>
      <id>latency</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>latency-baseline</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <skipTests>false</skipTests>
                  <excludes combine.self="override"/>
                  <includes>
                    <include>**/LatencyBaselineTest.java</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <properties>
    <client.args>--view-map default</client.args>
  </properties>

  <dependencies>
    <dependency><groupId>com.fulcrologic.jxpilot</groupId><artifactId>jxpilot-common</artifactId></dependency>
    <dependency><groupId>com.fulcrologic.jxpilot</groupId><artifactId>jxpilot-server</artifactId></dependency>
    <dependency><groupId>com.fulcrologic.jxpilot</groupId><artifactId>jxpilot-common</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>${lwjgl.natives}</classifier></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>${lwjgl.natives}</classifier></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>${lwjgl.natives}</classifier></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>${lwjgl.natives}</classifier></dependency>
    <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>${lwjgl.natives}</classifier></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- mvn -pl client exec:exec, optionally with -Dclient.args="(viewer options)".
             -Xms64m / SoftMaxHeapSize: the render loop allocates nothing, so a small, pre-sized heap
             keeps ZGC idle and the footprint low. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>java</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
          <commandlineArgs>${jvm.platform.args} --enable-native-access=ALL-UNNAMED -XX:+UseZGC -Xms64m -XX:SoftMaxHeapSize=128m -classpath %classpath com.fulcrologic.jxpilot.client.ClientMain ${client.args}</commandlineArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/AllocationTest.java</exclude>
            <exclude>**/*NetAllocationTest.java</exclude>
            <exclude>**/AppAllocationTest.java</exclude>
            <!-- ~40 s of virtual-time games: opt in with -Platency (docs/latency-measurements.md) -->
            <exclude>**/LatencyBaselineTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- Allocation tests run in their own JVMs with escape analysis off, so a passing result
               depends neither on the JIT scalar-replacing objects nor on other tests' JIT state. -->
          <execution>
            <id>allocation-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/AllocationTest.java</include>
              </includes>
              <argLine>-XX:-DoEscapeAnalysis</argLine>
            </configuration>
          </execution>
          <execution>
            <id>app-allocation-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/AppAllocationTest.java</include>
              </includes>
              <argLine>-XX:-DoEscapeAnalysis</argLine>
            </configuration>
          </execution>
          <execution>
            <id>net-allocation-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/*NetAllocationTest.java</include>
              </includes>
              <argLine>-XX:-DoEscapeAnalysis</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.fulcrologic.jxpilot.client.render.*</param>
            <param>com.fulcrologic.jxpilot.client.map.*</param>
            <param>com.fulcrologic.jxpilot.client.viewer.*</param>
            <param>com.fulcrologic.jxpilot.client.paint.*</param>
            <param>com.fulcrologic.jxpilot.client.net.*</param>
            <param>com.fulcrologic.jxpilot.client.game.*</param>
            <param>com.fulcrologic.jxpilot.client.xp.*</param>
            <param>com.fulcrologic.jxpilot.client.app.*</param>
            <param>com.fulcrologic.jxpilot.client.sound.*</param>
          </targetClasses>
          <!-- DemoWorld and DemoHud are fake animation data for the demo viewer mode; UdpTransport and
               ClientSim are I/O edges covered by loopback tests; GameApp, AppLauncher and MapLook are GL/GLFW glue;
               OpenAlDevice is OpenAL glue (SoundSystemTest drives it on a real device when there is one). -->
          <excludedClasses>
            <param>com.fulcrologic.jxpilot.client.viewer.DemoWorld</param>
            <param>com.fulcrologic.jxpilot.client.viewer.DemoHud</param>
            <param>com.fulcrologic.jxpilot.client.net.UdpTransport</param>
            <param>com.fulcrologic.jxpilot.client.net.ClientSim</param>
            <param>com.fulcrologic.jxpilot.client.xp.XpClientSim*</param>
            <param>com.fulcrologic.jxpilot.client.app.GameApp*</param>
            <param>com.fulcrologic.jxpilot.client.app.AppLauncher</param>
            <param>com.fulcrologic.jxpilot.client.app.MapLook</param>
            <param>com.fulcrologic.jxpilot.client.sound.OpenAlDevice</param>
          </excludedClasses>
          <targetTests>
            <param>com.fulcrologic.jxpilot.client.*</param>
          </targetTests>
          <excludedTestClasses>
            <param>com.fulcrologic.jxpilot.client.AllocationTest</param>
            <param>com.fulcrologic.jxpilot.client.sound.AllocationTest</param>
            <param>*NetAllocationTest*</param>
            <param>*AppAllocationTest*</param>
            <param>*UdpLoopbackTest*</param>
            <!-- the latency harness: whole games in virtual time, a measurement rather than unit tests -->
            <param>com.fulcrologic.jxpilot.client.latency.*</param>
          </excludedTestClasses>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
