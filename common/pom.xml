<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fulcrologic.jxpilot</groupId>
    <artifactId>jxpilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jxpilot-common</artifactId>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The standard maps (com.fulcrologic.jxpilot.common.map.BundledMaps), copied byte for byte from the
           repository's maps/ so git holds one copy. xpilot/maps/index.txt lists them. -->
      <resource>
        <directory>${project.basedir}/../maps</directory>
        <includes>
          <include>*.xp</include>
          <include>README.md</include>
        </includes>
        <targetPath>xpilot/maps</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- The test-jar shares test fixtures (the lossy-link emulator, common.net.link) with the client and
           server tests and with tools/lagproxy. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <!-- each test module has its own JUnit configuration -->
              <excludes>
                <exclude>junit-platform.properties</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/AllocationTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- Allocation tests run separately with escape analysis off, so a passing result does not
               depend on the JIT scalar-replacing objects that the code allocates. -->
          <execution>
            <id>allocation-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/AllocationTest.java</include>
              </includes>
              <argLine>-XX:-DoEscapeAnalysis</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.fulcrologic.jxpilot.common.*</param>
          </targetClasses>
          <targetTests>
            <param>com.fulcrologic.jxpilot.common.*</param>
          </targetTests>
          <excludedTestClasses>
            <param>*AllocationTest*</param>
          </excludedTestClasses>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
</project>
