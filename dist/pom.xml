<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fulcrologic.jxpilot</groupId>
    <artifactId>jxpilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jxpilot-dist</artifactId>
  <name>JXPilot distribution</name>
  <description>
    Release packaging: the macOS-aware client launcher, the generated user-guide tables and (with
    -Prelease) the runnable jars jxpilot-client-VERSION.jar (all desktop LWJGL natives) and
    jxpilot-server-VERSION.jar (headless) in target/release/.
  </description>

  <properties>
    <!-- Set to true to rewrite docs/guide/generated/*.adoc instead of failing when they are stale. -->
    <jxpilot.regenerateDocs>false</jxpilot.regenerateDocs>
    <release.dir>${project.build.directory}/release</release.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fulcrologic.jxpilot</groupId>
      <artifactId>jxpilot-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fulcrologic.jxpilot</groupId>
      <artifactId>jxpilot-server</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- GPL text inside both jars. -->
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <jxpilot.repoRoot>${project.basedir}/..</jxpilot.repoRoot>
            <jxpilot.regenerateDocs>${jxpilot.regenerateDocs}</jxpilot.regenerateDocs>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.fulcrologic.jxpilot.dist.LaunchPlan</param>
          </targetClasses>
          <targetTests>
            <param>com.fulcrologic.jxpilot.dist.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn -B -Prelease verify    (from the repo root)
      builds target/release/jxpilot-client-VERSION.jar and target/release/jxpilot-server-VERSION.jar.
      The client jar carries LWJGL natives for every desktop platform; LWJGL extracts the one it needs.
    -->
    <profile>
      <id>release</id>
      <dependencies>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-macos-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-macos</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-linux</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-linux-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-windows</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>natives-macos-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>natives-macos</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>natives-linux</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>natives-linux-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><classifier>natives-windows</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>natives-macos-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>natives-macos</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>natives-linux</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>natives-linux-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><classifier>natives-windows</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-macos-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-macos</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-linux</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-linux-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-windows</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>natives-macos-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>natives-macos</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>natives-linux</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>natives-linux-arm64</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><classifier>natives-windows</classifier></dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.2</version>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
            </configuration>
            <executions>
              <execution>
                <id>client-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <outputFile>${release.dir}/jxpilot-client-${project.version}.jar</outputFile>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/versions/*/module-info.class</exclude>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                        <exclude>META-INF/INDEX.LIST</exclude>
                      </excludes>
                    </filter>
                  </filters>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>com.fulcrologic.jxpilot.dist.ClientLauncher</mainClass>
                      <manifestEntries>
                        <Multi-Release>true</Multi-Release>
                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        <Implementation-Title>JXPilot client</Implementation-Title>
                        <Implementation-Version>${project.version}</Implementation-Version>
                        <Implementation-URL>https://github.com/awkay/jxpilot</Implementation-URL>
                      </manifestEntries>
                    </transformer>
                  </transformers>
                </configuration>
              </execution>
              <execution>
                <id>server-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <outputFile>${release.dir}/jxpilot-server-${project.version}.jar</outputFile>
                  <artifactSet>
                    <includes>
                      <include>com.fulcrologic.jxpilot:jxpilot-dist</include>
                      <include>com.fulcrologic.jxpilot:jxpilot-common</include>
                      <include>com.fulcrologic.jxpilot:jxpilot-server</include>
                    </includes>
                  </artifactSet>
                  <filters>
                    <!-- From this module the server jar takes only the GPL text and notices. -->
                    <filter>
                      <artifact>com.fulcrologic.jxpilot:jxpilot-dist</artifact>
                      <excludes>
                        <exclude>com/**</exclude>
                        <exclude>META-INF/licenses/lwjgl/**</exclude>
                      </excludes>
                    </filter>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>com.fulcrologic.jxpilot.server.ServerMain</mainClass>
                      <manifestEntries>
                        <Implementation-Title>JXPilot server</Implementation-Title>
                        <Implementation-Version>${project.version}</Implementation-Version>
                        <Implementation-URL>https://github.com/awkay/jxpilot</Implementation-URL>
                      </manifestEntries>
                    </transformer>
                  </transformers>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
