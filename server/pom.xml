<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fulcrologic.jxpilot</groupId>
    <artifactId>jxpilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jxpilot-server</artifactId>
  <dependencies><dependency><groupId>com.fulcrologic.jxpilot</groupId><artifactId>jxpilot-common</artifactId></dependency>
    <dependency><groupId>com.fulcrologic.jxpilot</groupId><artifactId>jxpilot-common</artifactId><type>test-jar</type><scope>test</scope></dependency></dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/AllocationTest.java</exclude>
            <exclude>**/TickBenchmark.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- Allocation tests run separately with escape analysis off, so a passing result does not
               depend on the JIT scalar-replacing objects that the code allocates. -->
          <execution>
            <id>allocation-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/AllocationTest.java</include>
              </includes>
              <argLine>-XX:-DoEscapeAnalysis</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.fulcrologic.jxpilot.server.*</param>
          </targetClasses>
          <targetTests>
            <param>com.fulcrologic.jxpilot.server.*</param>
          </targetTests>
          <excludedClasses>
            <param>com.fulcrologic.jxpilot.server.ServerMain</param>
            <param>com.fulcrologic.jxpilot.server.net.UdpTransport</param>
            <!-- effectful edges and orchestration, covered by LoopbackIntegrationTest -->
            <param>com.fulcrologic.jxpilot.server.net.Server</param>
            <param>com.fulcrologic.jxpilot.server.net.Server$*</param>
            <param>com.fulcrologic.jxpilot.server.net.JdkInterfaceSource</param>
            <param>com.fulcrologic.jxpilot.server.net.JdkResolver</param>
            <!-- placeholder simulation, kept for the network tests -->
            <param>com.fulcrologic.jxpilot.server.net.StubGameHost</param>
            <!-- effectful edge (starts a real server), covered by LocalServerProviderTest and the client E2E tests -->
            <param>com.fulcrologic.jxpilot.server.host.LocalServerProvider*</param>
          </excludedClasses>
          <excludedTestClasses>
            <param>*AllocationTest*</param>
            <param>*TickBenchmark*</param>
            <param>*LoopbackIntegrationTest*</param>
            <param>*ServerMainTest*</param>
            <param>*LocalServerProviderTest*</param>
            <param>*RobotStatsRegressionTest*</param>
          </excludedTestClasses>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.fulcrologic.jxpilot.server.ServerMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
