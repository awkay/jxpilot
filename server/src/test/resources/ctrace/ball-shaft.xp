# JXPilot golden-trace map (GPL-2.0-or-later, see LICENSE): a treasure at the
# bottom of a one-block shaft beside the base, for dropping a ball back onto
# its treasure and for a connector that snaps easily.
mapName: ball-shaft
mapAuthor: JXPilot
mapWidth: 12
mapHeight: 12
teamPlay: no
edgeWrap: no
maxBallConnectorRatio: 0.15
# the C server also reads lib/defaults: pin what it sets there
gravity: -0.25
maxItemDensity: 0
movingItemProb: 0
framesPerSecond: 14
mapData: \multiline: EndOfMapdata
