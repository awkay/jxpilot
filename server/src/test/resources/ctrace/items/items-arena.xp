# Two bases, one 4 blocks above the other, and an item concentrator just
# above the upper base: with -gravity 0 both ships stay put, the lower ship's
# laser (pointing up) reaches the upper one, and items spawned at the
# concentrator are picked up by the upper ship.
mapWidth:	21
mapHeight:	14
mapName:	JXPilot item arena
mapAuthor:	JXPilot contributors
edgeWrap:	no
teamPlay:	no
