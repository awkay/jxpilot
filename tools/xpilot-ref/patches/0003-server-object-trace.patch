xpilot-ref patch 0003: optional per-tick trace of balls, asteroids, wreckage,
race progress, treasures and targets.

This patch modifies XPilot 4.5.5 (GPL-2.0-or-later, Copyright (C) 1991-2010
by Bjoern Stabell, Ken Ronny Schouten, Bert Gijsbers, Dick Balaska et al.).
It is a derivative work distributed under the same license.

Why: to compare the reimplementation's game modes (ball connector physics,
asteroid motion, race timing, treasure and target state) numerically against
the original server.  Applies on top of patch 0002.  Adds Trace_objects() to
src/server/server.c, called right after Trace_players().  It is inert unless
the environment variable XPILOT_TRACE_OBJS is set.  Game logic is unchanged.

--- a/src/server/server.c
+++ b/src/server/server.c
@@ -288,6 +288,83 @@
 		pl->fuel.sum,
 		BIT(pl->status, THRUSTING) ? 1 : 0,
 		(unsigned long)pl->status, pl->name);
+    }
+    fflush(stderr);
+}
+
+/*
+ * xpilot-ref trace hook 2 (not part of upstream XPilot 4.5.5).
+ * When XPILOT_TRACE_OBJS is set, print after each Update_objects():
+ *   XPOBJ  loop frame ptr type cx cy prevx prevy vx vy life id team status mass extra...
+ *          (balls: owner treasure length; asteroids/wreckage: size rotation turnspeed info)
+ *          for every ball, asteroid and wreckage object;
+ *   XPPL2  loop frame id used have ball check round time best_lap last_lap last_lap_time mychar
+ *          for every player;
+ *   XPTRS  loop frame index have destroyed   (every treasure)
+ *   XPTGT  loop frame index damage dead_time (every target)
+ *   XPTEAM loop frame team left destroyed score (teams with treasures)
+ * Has no effect unless XPILOT_TRACE_OBJS is set.
+ */
+static void Trace_objects(void)
+{
+    static int		init = 0;
+    static int		on = 0;
+    int			i;
+
+    if (!init) {
+	init = 1;
+	on = (getenv("XPILOT_TRACE_OBJS") != NULL);
+    }
+    if (!on) {
+	return;
+    }
+    for (i = 0; i < NumObjs; i++) {
+	object *obj = Obj[i];
+	if (!BIT(obj->type, OBJ_BALL|OBJ_ASTEROID|OBJ_WRECKAGE)) {
+	    continue;
+	}
+	fprintf(stderr, "XPOBJ %ld %ld %p %d %d %d %d %d %.9g %.9g %ld %d %d %#lx %.9g",
+		main_loops, frame_loops, (void *)obj, (int)obj->type,
+		obj->pos.cx, obj->pos.cy, obj->prevpos.x, obj->prevpos.y,
+		(double)obj->vel.x, (double)obj->vel.y, obj->life,
+		(int)obj->id, (int)obj->team, (unsigned long)obj->status,
+		(double)obj->mass);
+	if (obj->type == OBJ_BALL) {
+	    ballobject *b = BALL_PTR(obj);
+	    fprintf(stderr, " %d %d %.9g\n", b->owner, b->treasure,
+		    (double)b->length);
+	} else {
+	    wireobject *wo = WIRE_PTR(obj);
+	    fprintf(stderr, " %d %d %.9g %ld\n", (int)wo->size,
+		    (int)wo->rotation, (double)wo->turnspeed, wo->info);
+	}
+    }
+    for (i = 0; i < NumPlayers; i++) {
+	player *pl = Players[i];
+	fprintf(stderr, "XPPL2 %ld %ld %d %#lx %#lx %p %d %d %d %d %d %d %c\n",
+		main_loops, frame_loops, (int)pl->id,
+		(unsigned long)pl->used, (unsigned long)pl->have,
+		(void *)pl->ball, pl->check, pl->round, pl->time,
+		pl->best_lap, pl->last_lap, pl->last_lap_time,
+		pl->mychar > ' ' ? pl->mychar : '_');
+    }
+    for (i = 0; i < World.NumTreasures; i++) {
+	fprintf(stderr, "XPTRS %ld %ld %d %d %d\n", main_loops, frame_loops,
+		i, (int)World.treasures[i].have,
+		World.treasures[i].destroyed);
+    }
+    for (i = 0; i < World.NumTargets; i++) {
+	fprintf(stderr, "XPTGT %ld %ld %d %d %d\n", main_loops, frame_loops,
+		i, World.targets[i].damage, World.targets[i].dead_time);
+    }
+    for (i = 0; i < MAX_TEAMS; i++) {
+	if (World.teams[i].NumTreasures == 0) {
+	    continue;
+	}
+	fprintf(stderr, "XPTEAM %ld %ld %d %d %d %.9g\n", main_loops,
+		frame_loops, i, World.teams[i].TreasuresLeft,
+		World.teams[i].TreasuresDestroyed,
+		(double)World.teams[i].score);
     }
     fflush(stderr);
 }
