 }
+
 
+/*
+ * xpilot-ref wreckage trace (patch 0003, not part of upstream XPilot 4.5.5).
+ * With XPILOT_TRACE_WRECK set, Make_wreckage prints its arguments
+ * ("XPWMAKE") and every rfrac() value it draws ("XPWRAND"), exactly (%a).
+ */
+static int xpref_wreck_trace(void)
+{
+    static int init = 0, on = 0;
+    if (!init) {
+	init = 1;
+	on = (getenv("XPILOT_TRACE_WRECK") != NULL);
+    }
+    return on;
+}
+
+static double xpref_wreck_rfrac(void)
+{
+    double v = rfrac();
+    if (xpref_wreck_trace()) {
+	fprintf(stderr, "XPWRAND %a\n", v);
+    }
+    return v;
+}
 
