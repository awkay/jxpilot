xpilot-ref patch 0003: optional wreckage trace in the server.

This patch modifies XPilot 4.5.5 (GPL-2.0-or-later, Copyright (C) 1991-2010
by Bjoern Stabell, Ken Ronny Schouten, Bert Gijsbers, Dick Balaska et al.).
It is a derivative work distributed under the same license.

Why: to compare a reimplementation's wreckage (ship.c Make_wreckage and the
wreckage objects' flight) numerically against the original server.  Inert
unless the environment variable XPILOT_TRACE_WRECK is set; then
Make_wreckage prints its arguments ("XPWMAKE frame ...") and every rfrac()
value it draws ("XPWRAND <hex double>"), and after each Update_objects()
every wreckage object is printed ("XPWRECK main_loops frame_loops ptr cx cy
vx vy life mass size info rotation turnspeed id").  Floats use %a, so they
are exact.  Game logic and the random sequence are unchanged.  Applies after
patch 0002.

--- a/src/server/server.c
+++ b/src/server/server.c
@@ -288,6 +288,43 @@
 		pl->fuel.sum,
 		BIT(pl->status, THRUSTING) ? 1 : 0,
 		(unsigned long)pl->status, pl->name);
+    }
+    fflush(stderr);
+}
+
+/*
+ * xpilot-ref wreckage trace (patch 0003, not part of upstream XPilot 4.5.5).
+ * When XPILOT_TRACE_WRECK is set, print every wreckage object after each
+ * Update_objects() call: "XPWRECK main_loops frame_loops ptr cx cy vx vy
+ * life mass size info rotation turnspeed id".  Floats are exact (%a).
+ */
+static void Trace_wreckage(void)
+{
+    static int		init = 0;
+    static int		on = 0;
+    int			i;
+
+    if (!init) {
+	init = 1;
+	on = (getenv("XPILOT_TRACE_WRECK") != NULL);
+    }
+    if (!on) {
+	return;
+    }
+    for (i = 0; i < NumObjs; i++) {
+	object *obj = Obj[i];
+	wireobject *wr;
+	if (obj->type != OBJ_WRECKAGE) {
+	    continue;
+	}
+	wr = WIRE_PTR(obj);
+	fprintf(stderr, "XPWRECK %ld %ld %p %d %d %a %a %ld %a %d %d %d %a %d\n",
+		main_loops, frame_loops, (void *)obj,
+		obj->pos.cx, obj->pos.cy,
+		(double)obj->vel.x, (double)obj->vel.y,
+		(long)obj->life, (double)obj->mass,
+		(int)wr->size, (int)wr->info, (int)wr->rotation,
+		(double)wr->turnspeed, (int)obj->id);
     }
     fflush(stderr);
 }
@@ -330,6 +367,7 @@
 
 	Update_objects();
 	Trace_players();
+	Trace_wreckage();
 
 	if ((main_loops % UPDATES_PR_FRAME) == 0) {
 	    Frame_update();
--- a/src/server/ship.c
+++ b/src/server/ship.c
