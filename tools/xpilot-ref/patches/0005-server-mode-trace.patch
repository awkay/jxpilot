+/*
+ * xpilot-ref message trace (not part of upstream XPilot 4.5.5): with
+ * XPILOT_TRACE_MODES set, every game message as "XPMSG loop frame to text"
+ * (to: * for everyone, else the player id).  Game logic is unchanged.
+ */
+static void Trace_message(int to, const char *text)
+{
+    static int	init = 0;
+    static int	on = 0;
+    extern long	main_loops;
+
+    if (!init) {
+	init = 1;
+	on = (getenv("XPILOT_TRACE_MODES") != NULL);
+    }
+    if (on) {
+	if (to < 0) {
+	    fprintf(stderr, "XPMSG %ld %ld * %s\n", main_loops, frame_loops, text);
+	} else {
+	    fprintf(stderr, "XPMSG %ld %ld %d %s\n", main_loops, frame_loops, to, text);
+	}
+    }
+}
