 /*
+ * xpilot-ref random number and cannon trace (patch 0006, not part of
+ * upstream XPilot 4.5.5).  Inert unless XPILOT_TRACE_RAND is set; then every
+ * server rfrac()/randomMT() call prints "XPRAND func file:line f|i value"
+ * (value = the 32 bit randomMT() number; rfrac() is value / 2^32), every
+ * Make_debris() call prints "XPDEBRIS ..." (play.c), and after each
+ * Update_objects() every spark and debris object that is not owner-immune
+ * (explosion debris: thrust and wall sparks are owner-immune) prints
+ * "XPDEB loop frame index type id cx cy vx vy mass life status" and every
+ * cannon whose state is not idle prints "XPCANNON loop frame index
+ * dead_time damaged tractor_count used emergency_shield_left
+ * phasing_left".  The random sequence is unchanged.
+ */
+const char *xpref_debris_func = "?", *xpref_debris_file = "?";
+int xpref_debris_line = 0;
+
+int xpref_trace_rand(void)
+{
+    static int init = 0, on = 0;
+    if (!init) {
+	init = 1;
+	on = (getenv("XPILOT_TRACE_RAND") != NULL);
+    }
+    return on;
+}
+
+unsigned int xpref_randomMT(const char *func, const char *file, int line)
+{
+    unsigned int v = (randomMT)();
+    if (xpref_trace_rand()) {
+	fprintf(stderr, "XPRAND %s %s:%d i %u\n", func, file, line, v);
+    }
+    return v;
+}
+
+double xpref_rfrac(const char *func, const char *file, int line)
+{
+    /* exactly common/math.c rfrac() */
+    unsigned int v = (randomMT)();
+    if (xpref_trace_rand()) {
+	fprintf(stderr, "XPRAND %s %s:%d f %u\n", func, file, line, v);
+    }
+    return (double) v * 0.00000000023283064365386962890625;
+}
+
+static void Trace_cannons(void)
+{
+    int i;
+
+    if (!xpref_trace_rand()) {
+	return;
+    }
+    for (i = 0; i < NumObjs; i++) {
+	object *obj = Obj[i];
+	if (!BIT(obj->type, OBJ_SPARK|OBJ_DEBRIS)
+	    || BIT(obj->status, OWNERIMMUNE)) {
+	    continue;
+	}
+	fprintf(stderr, "XPDEB %ld %ld %d %d %d %d %d %a %a %a %ld %#lx\n",
+		main_loops, frame_loops, i, obj->type, (int)obj->id,
+		obj->pos.cx, obj->pos.cy, (double)obj->vel.x,
+		(double)obj->vel.y, (double)obj->mass, (long)obj->life,
+		(unsigned long)obj->status);
+    }
+    for (i = 0; i < World.NumCannons; i++) {
+	cannon_t *c = World.cannon + i;
+	if (c->dead_time || c->damaged || c->tractor_count || c->used
+	    || c->emergency_shield_left || c->phasing_left) {
+	    fprintf(stderr, "XPCANNON %ld %ld %d %d %d %d %#lx %d %d\n",
+		    main_loops, frame_loops, i, c->dead_time, c->damaged,
+		    c->tractor_count, (unsigned long)c->used,
+		    c->emergency_shield_left, c->phasing_left);
+	}
+    }
+    fflush(stderr);
+}
+
