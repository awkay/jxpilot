+/*
+ * xpref_rfrac(), xpref_randomMT(), the Make_debris call-site record
+ * (xpilot-ref patch 0006, not part of upstream XPilot 4.5.5): every server
+ * call of rfrac() and randomMT() goes through server.c, which prints the
+ * value and its call site when XPILOT_TRACE_RAND is set; Make_debris
+ * learns its caller.  The values and their order are unchanged.
+ */
+extern double xpref_rfrac(const char *func, const char *file, int line);
+extern unsigned int xpref_randomMT(const char *func, const char *file,
+				   int line);
