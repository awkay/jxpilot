+/*
+ * xpilot-ref robot trace (not part of upstream XPilot 4.5.5).
+ * When the environment variable XPILOT_TRACE_ROBOT is set, print the
+ * default robot's decision state after each Robot_default_play() call to
+ * stderr, one "XPROBOT ..." line per robot per play.  "evaded" is 1 when
+ * the play returned through Check_robot_evade().  Has no effect otherwise.
+ */
+static void Robot_default_play_trace(int ind)
+{
+    static int			trace_init = 0;
+    static int			trace_on = 0;
+    player			*pl = Players[ind];
+    robot_default_data_t	*my_data;
 
+    if (!trace_init) {
+	trace_init = 1;
+	trace_on = (getenv("XPILOT_TRACE_ROBOT") != NULL);
+	if (trace_on) {
+	    fprintf(stderr, "XPROBOT_HDR loop frame id mode longterm lock"
+		    " evaded turnacc power thrusting x y name\n");
+	}
+    }
+    xpref_evaded = 0;
+    Robot_default_play(ind);
+    if (!trace_on) {
+	return;
+    }
+    my_data = Robot_default_get_data(pl);
+    fprintf(stderr, "XPROBOT %ld %ld %d %d %d %d %d %.9g %.9g %d %d %d %s\n",
+	    main_loops, frame_loops, (int)pl->id, my_data->robot_mode,
+	    my_data->longterm_mode, my_data->robot_lock, xpref_evaded,
+	    (double)pl->turnacc, (double)pl->power,
+	    BIT(pl->status, THRUSTING) ? 1 : 0, pl->pos.x, pl->pos.y, pl->name);
+}
