     }
     if (!evade_checked) {
 	if (Check_robot_evade(ind, mine_i, ship_i)) {
+	    xpref_evaded = 1;	/* xpilot-ref robot trace */
 	    if (playerShielding == 0
 		&& playerStartsShielded != 0
